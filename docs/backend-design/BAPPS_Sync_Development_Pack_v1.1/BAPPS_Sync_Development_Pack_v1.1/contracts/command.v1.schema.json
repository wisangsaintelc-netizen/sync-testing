{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bapps.local/contracts/command.v1.schema.json",
  "title": "BAPPS Sync Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "type",
    "issued_at",
    "expires_at",
    "lease_expires_at",
    "idempotency_key",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "command_id": {
      "type": "string",
      "minLength": 8
    },
    "type": {
      "enum": [
        "run_now",
        "stop_run",
        "pause_sync",
        "resume_sync",
        "refresh_config"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "lease_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "run_now"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "sync_code"
            ],
            "properties": {
              "sync_code": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "stop_run"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "run_id"
            ],
            "properties": {
              "run_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "pause_sync",
              "resume_sync"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "sync_code"
            ],
            "properties": {
              "sync_code": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "refresh_config"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "maxProperties": 0
          }
        }
      }
    }
  ]
}
