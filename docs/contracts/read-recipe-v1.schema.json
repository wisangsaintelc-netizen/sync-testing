{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bapps-sync:contracts:read-recipe:v1",
  "title": "BAPPS Sync declarative read recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recipe_code",
    "recipe_version",
    "engine",
    "minimum_agent_version",
    "source",
    "target",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "recipe_code": {
      "$ref": "#/$defs/safeIdentifier"
    },
    "recipe_version": {
      "type": "integer",
      "minimum": 1
    },
    "engine": {
      "const": "declarative_table_reader"
    },
    "minimum_agent_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_ref", "driver", "table", "columns"],
      "allOf": [
        {
          "if": {
            "properties": {
              "driver": {
                "const": "sqlserver"
              }
            }
          },
          "then": {
            "required": ["schema"]
          }
        },
        {
          "if": {
            "properties": {
              "driver": {
                "const": "firebird"
              }
            }
          },
          "then": {
            "not": {
              "required": ["schema"]
            }
          }
        }
      ],
      "properties": {
        "profile_ref": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "driver": {
          "enum": ["sqlserver", "firebird"]
        },
        "schema": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "table": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeIdentifier"
          }
        },
        "schema_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "where": {
          "$ref": "#/$defs/predicate"
        },
        "parent_scope": {
          "$ref": "#/$defs/parentScope"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_ref", "table", "strategy", "ownership"],
      "properties": {
        "profile_ref": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "table": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "strategy": {
          "enum": ["full_snapshot", "daily_history_v1"]
        },
        "ownership": {
          "enum": ["create_new", "managed_only"]
        },
        "key_columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeIdentifier"
          }
        }
      }
    },
    "constants": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/safeIdentifier"
      },
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "null"]
      }
    },
    "transformations": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": ["profit.article_tax_rate_v1"]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_rows",
        "statement_timeout_seconds",
        "max_runtime_seconds"
      ],
      "properties": {
        "batch_rows": {
          "type": "integer",
          "minimum": 100,
          "maximum": 5000
        },
        "statement_timeout_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600
        },
        "max_runtime_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 21600
        }
      }
    }
  },
  "$defs": {
    "safeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
    },
    "scalar": {
      "type": ["string", "number", "integer", "boolean", "null"]
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "column", "value"],
          "properties": {
            "operator": {
              "const": "eq"
            },
            "column": {
              "$ref": "#/$defs/safeIdentifier"
            },
            "value": {
              "$ref": "#/$defs/scalar"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "column", "values"],
          "properties": {
            "operator": {
              "const": "in"
            },
            "column": {
              "$ref": "#/$defs/safeIdentifier"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/scalar"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "column"],
          "properties": {
            "operator": {
              "enum": ["is_null", "is_not_null"]
            },
            "column": {
              "$ref": "#/$defs/safeIdentifier"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "column", "window"],
          "properties": {
            "operator": {
              "const": "date_window"
            },
            "column": {
              "$ref": "#/$defs/safeIdentifier"
            },
            "window": {
              "const": "current_calendar_year"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "predicates"],
          "properties": {
            "operator": {
              "enum": ["and", "or"]
            },
            "predicates": {
              "type": "array",
              "minItems": 2,
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        }
      ]
    },
    "parentScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table",
        "child_column",
        "parent_column",
        "where"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "table": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "child_column": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "parent_column": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "where": {
          "$ref": "#/$defs/predicate"
        }
      }
    }
  }
}
